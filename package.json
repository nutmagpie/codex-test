{
  "name": "60-in-60",
  "version": "1.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node tools/expo.mjs start",
    "web": "node tools/expo.mjs start --web --offline",
    "ios": "node tools/expo.mjs start --ios",
    "android": "node tools/expo.mjs start --android",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "node tools/expo.mjs export --platform all",
    "build:web": "node tools/expo.mjs export --platform web"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.37",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.49.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "~19.1.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
